          }
        }
      }
    },
    "BootPreference is set to a value LidBoot doesn't recognize (0x%@), so it won't change it.": {
      "extractionState": "manual",
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O BootPreference está definido para um valor que o LidBoot não reconhece (0x%@), por isso não o vai alterar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "BootPreference tiene un valor que LidBoot no reconoce (0x%@), así que no lo cambiará."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BootPreference ist auf einen Wert gesetzt, den LidBoot nicht kennt (0x%@), daher wird er nicht geändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BootPreference contient une valeur que LidBoot ne reconnaît pas (0x%@) ; il ne la modifiera donc pas."
          }
        }
      }
    },
    "LidBoot changes BootPreference, a start-up setting in your Mac's firmware that Apple documents.": {
      "extractionState": "manual",
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O LidBoot altera o BootPreference, uma definição de arranque no firmware do teu Mac que a Apple documenta."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LidBoot cambia BootPreference, un ajuste de arranque del firmware del Mac que Apple documenta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LidBoot ändert BootPreference, eine von Apple dokumentierte Starteinstellung in der Firmware deines Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LidBoot modifie BootPreference, un réglage de démarrage du firmware de votre Mac documenté par Apple."
          }
        }
      }
    },
