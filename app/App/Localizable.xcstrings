    "It survives restarts and updates. Restore Default removes it completely, leaving your Mac exactly as it shipped.": {
      "extractionState": "manual",
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém-se após reinícios e atualizações. Repor predefinição remove-a por completo, deixando o teu Mac exatamente como veio de origem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrevive a reinicios y actualizaciones. Restaurar valor predeterminado lo elimina por completo, dejando el Mac exactamente como venía de fábrica."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie überlebt Neustarts und Updates. „Standard wiederherstellen“ entfernt sie vollständig und lässt den Mac genau so zurück, wie er ausgeliefert wurde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il survit aux redémarrages et aux mises à jour. « Rétablir la valeur par défaut » le supprime complètement, laissant votre Mac exactement comme à sa sortie d'usine."
          }
        }
      }
    },
    "It only applies from a full shutdown. Waking your Mac from sleep is never affected.": {
      "extractionState": "manual",
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só se aplica a partir de um encerramento completo. Acordar o Mac do modo de repouso nunca é afetado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se aplica tras un apagado completo. Despertar el Mac del reposo nunca se ve afectado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie gilt nur nach einem vollständigen Ausschalten. Das Aufwecken aus dem Ruhezustand ist nie betroffen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne s'applique qu'après un arrêt complet. La sortie de veille de votre Mac n'est jamais affectée."
          }
        }
      }
    },
