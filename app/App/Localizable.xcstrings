    },
    "Needs approval in System Settings › Login Items. Click to open.": {
      "extractionState": "manual",
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa de aprovação em Definições do Sistema › Itens de Início de Sessão. Clica para abrir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita aprobación en Ajustes del Sistema › Ítems de inicio. Haz clic para abrir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Muss in Systemeinstellungen › Anmeldeobjekte genehmigt werden. Zum Öffnen klicken."
