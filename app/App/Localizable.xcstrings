    "Your Mac still starts up if you press a key or touch the trackpad.": {
      "extractionState": "manual",
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu Mac continua a arrancar se carregares numa tecla ou tocares no trackpad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac sigue arrancando si pulsas una tecla o tocas el trackpad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Mac startet weiterhin, wenn du eine Taste drückst oder das Trackpad berührst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Mac démarre toujours si vous appuyez sur une touche ou touchez le trackpad."
          }
        }
      }
    },
    "Starts up when you open the lid or connect power.": {
      "extractionState": "manual",
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arranca ao abrir a tampa ou ao ligar à corrente."
          }
