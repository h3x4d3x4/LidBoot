    "Just for quick access — your setting holds either way": {
      "extractionState": "manual",
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas para acesso rápido — a definição mantém-se"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para acceso rápido: el ajuste se mantiene igualmente"
