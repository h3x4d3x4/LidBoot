    "macOS couldn't verify your password, so nothing changed.": {
      "extractionState": "manual",
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS não conseguiu verificar a tua palavra-passe, por isso nada mudou."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no pudo verificar tu contraseña, así que no ha cambiado nada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS konnte dein Passwort nicht bestätigen, daher wurde nichts geändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n'a pas pu vérifier votre mot de passe, rien n'a donc changé."
          }
        }
      }
    },
    "Couldn't prepare the system command.": {
      "extractionState": "manual",
