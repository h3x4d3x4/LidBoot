        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enchufarlo arranca el Mac"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anschließen startet den Mac"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brancher démarre votre Mac"
          }
        }
      }
    },
    "Plugging in just charges it": {
      "extractionState": "manual",
      "localizations": {
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligar a ficha apenas carrega a bateria"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enchufarlo solo lo carga"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anschließen lädt ihn nur"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brancher ne fait que le charger"
          }
        }
      }
    },
